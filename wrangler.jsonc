{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tc-mobile",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Phase 1 is entirely offline and client-side: there is no Worker script and
  // no backend (docs/decisions/0005-no-backend-in-phase-1.md). Cloudflare still
  // deploys this as a Worker — a static-asset one — which is all that is needed
  // to hand a tester an HTTPS URL. HTTPS is not cosmetic here: getUserMedia
  // refuses to run outside a secure context, so a plain LAN address cannot
  // record audio and a workers.dev URL can.
  //
  // `assets` is NOT inherited by named environments, so each env repeats it.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },

  "env": {
    "staging": {
      "name": "tc-mobile-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
