{
  "name": "tc-mobile",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "description": "translationCore Mobile — offline-first audio notebook/editor PWA for oral Bible translation",
  "scripts": {
    "dev": "vite dev",
    "dev:lan": "vite dev --host",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "build:native": "vite build --mode native",
    "preview": "vite preview --host",
    "preview:e2e": "vite preview --outDir dist-e2e --host",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "test": "vitest run",
    "test:dist": "node scripts/test-dist.mjs",
    "test:dist:native": "npm run build:native && node scripts/test-dist-native.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run typecheck:lib && npm run test && npm run build && npm run test:dist",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "prepare": "husky",
    "knip": "knip --include dependencies,unlisted,files,exports,types",
    "typecheck:lib": "tsc -p tsconfig.lib.json",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:deploy:prod": "node scripts/check-deploy.mjs --require-origin --origin=https://tc-mobile.unfoldingword.workers.dev",
    "check:commit-msg": "node scripts/check-commit-messages.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsdom": "27.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "27.4.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  }
}
