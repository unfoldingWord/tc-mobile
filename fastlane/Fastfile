# iOS → TestFlight, no manual Mac step (#262).
#
# The `beta` lane archives the SAME web build the PWA ships (`dist/`, already
# copied into ios/ by `npx cap sync ios` before this runs) and uploads it to
# TestFlight. Signing is manual: a Distribution certificate (.p12) and an App
# Store provisioning profile (.mobileprovision) are decoded from secrets by the
# workflow, imported into a temporary keychain, and passed to xcodebuild
# directly. The API key is used only for the upload step — it does not touch
# signing. There is no `match`/certs repo.
#
# Why manual? Automatic signing (`-allowProvisioningUpdates` + API key) creates
# machine-bound keys in the runner's ephemeral keychain, which are discarded at
# the end of each run and eventually hit Apple's cert-per-machine limit. Manual
# signing hands CI a stable identity that lives in 1Password (uw-devops) and
# never changes between runs.
#
# Prerequisites the pipeline cannot create for you (docs/native/README.md §4a):
#   • an Apple Distribution certificate (.p12) in GitHub secret
#     IOS_DIST_CERT_P12_BASE64, its export password in IOS_DIST_CERT_PASSWORD;
#   • an App Store provisioning profile (.mobileprovision) tied to that cert,
#     in GitHub secret IOS_PROVISION_PROFILE_BASE64;
#   • an App Store Connect API key (App Manager role) for upload:
#     ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64;
#   • APPLE_TEAM_ID;
#   • the app record for org.unfoldingword.tcmobile in App Store Connect.
#
# Everything below runs on the macOS runner or a Mac; nothing here was executed
# in the Linux container this was authored in.

default_platform(:ios)

platform :ios do
  desc "Archive dist/ and upload to TestFlight"
  lane :beta do
    # On a GitHub-hosted macOS runner, codesign needs an unlocked keychain of
    # its own. `setup_ci` creates and unlocks a temporary keychain
    # (`fastlane_tmp_keychain`) and sets MATCH_KEYCHAIN_NAME /
    # MATCH_KEYCHAIN_PASSWORD; `import_certificate` below targets it by those
    # env vars. Without this the archive fails with `errSecInternalComponent`
    # after ~20 min of billed macOS time. Actions sets CI=true.
    setup_ci if ENV["CI"]

    # Import the Distribution certificate into the CI keychain. The .p12 is
    # decoded from a secret into fastlane/dist_cert.p12 by the workflow step
    # before fastlane runs. MATCH_KEYCHAIN_NAME / MATCH_KEYCHAIN_PASSWORD are
    # set by setup_ci above; the fallbacks are for local non-CI runs.
    import_certificate(
      certificate_path: "fastlane/dist_cert.p12",
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", ""),
    )

    # Extract the UUID from the provisioning profile before installing it.
    # `install_provisioning_profile` returns the installed file path, not the
    # UUID — and that path contains a space ("Provisioning Profiles/…") that
    # xcodebuild splits into a stray build-action argument, failing with
    # "Unknown build action 'Profiles/…'". Parse the UUID directly from the
    # .mobileprovision CMS envelope so PROVISIONING_PROFILE_SPECIFIER and the
    # export_options map both receive a clean UUID string.
    require "plist"
    require "shellwords"
    # Fastlane chdir-s to the fastlane/ directory before running the lane, so
    # a relative "fastlane/dist_profile.mobileprovision" resolves to
    # fastlane/fastlane/… and security cms returns nothing. __dir__ is the
    # absolute fastlane/ path, giving the correct file — same pattern as key_path.
    profile_abs_path = File.expand_path("dist_profile.mobileprovision", __dir__)
    profile_plist = `/usr/bin/security cms -D -i #{profile_abs_path.shellescape} 2>/dev/null`
    profile_uuid = Plist.parse_xml(profile_plist)["UUID"]
    UI.user_error!("Could not parse UUID from provisioning profile") unless profile_uuid

    # Install the provisioning profile into ~/Library/MobileDevice/Provisioning
    # Profiles/ so xcodebuild can find it by the UUID extracted above.
    install_provisioning_profile(
      path: "fastlane/dist_profile.mobileprovision",
    )

    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    # The .p8 is decoded from a secret into this path by the workflow. An
    # absolute path is required by `xcodebuild -authenticationKeyPath`.
    key_path = File.expand_path("AuthKey.p8", __dir__)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false,
    )

    # A unix timestamp for the build number: unique and strictly increasing on
    # every run with no round-trip to App Store Connect. Reading the latest
    # TestFlight build and adding one would race `skip_waiting_for_build_processing`
    # below — a rerun fired before Apple has indexed the previous upload reads the
    # stale latest and collides (a duplicate build App Store Connect rejects). A
    # timestamp also clears the manual build "1" the runbook uploads first and
    # needs no app record to pre-exist. CFBundleVersion takes a single integer up
    # to 2^32; a 10-digit epoch is well under that. The marketing version stays
    # MARKETING_VERSION from the project — bump it in the pbxproj when the
    # user-facing version changes (docs/native §6).
    build_number = Time.now.to_i.to_s

    # Signing flags. gym runs xcodebuild TWICE — archive, then export
    # (`xcodebuild -exportArchive`) — feeding `xcargs` to the first and
    # `export_xcargs` to the second.
    #
    # The project's target has CODE_SIGN_STYLE = Automatic in the pbxproj, but
    # that is overridden here by CODE_SIGN_STYLE=Manual so xcodebuild uses the
    # certificate and profile we imported rather than trying to create them.
    # DEVELOPMENT_TEAM is injected because the project sets none.
    #
    # For export, the export_options plist (signingStyle: manual,
    # provisioningProfiles map) drives signing; xcargs only carries the team.
    archive_xcargs = [
      "CODE_SIGN_STYLE=Manual",
      'CODE_SIGN_IDENTITY="Apple Distribution"',
      "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid}",
      "DEVELOPMENT_TEAM=#{team_id}",
    ].join(" ")
    export_xcargs = "DEVELOPMENT_TEAM=#{team_id}"

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "App.ipa",
      # CURRENT_PROJECT_VERSION is baked in at archive time, so it rides only on
      # the archive xcargs.
      xcargs: "#{archive_xcargs} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: export_xcargs,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "org.unfoldingword.tcmobile" => profile_uuid,
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      # Do not hold the (billed) macOS runner open while Apple processes the
      # build; processing and internal-tester distribution finish server-side.
      skip_waiting_for_build_processing: true,
      # Internal testers only. External distribution needs a Beta App Review and
      # is a deliberate, separate step in App Store Connect.
      distribute_external: false,
    )
  end
end
