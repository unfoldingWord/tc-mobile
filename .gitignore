# Dependencies
# No trailing slash: `node_modules/` matches a directory only, and a symlink
# is a file. One got committed that way.
node_modules

# Build output
dist/
dist-e2e/
dev-dist/
*.tsbuildinfo

# Playwright (#251)
/test-results/
/playwright-report/

# Cloudflare
.wrangler/

# Secrets
.env
.env.*
!.env.example
.dev.vars
secrets.*

# OS / IDE
.DS_Store
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Local agent skills. Vendored from elsewhere and not this repo's to publish —
# ui-craft is distilled third-party course material and the licensing/IP call
# is the author's, not something a commit should make by accident.
.claude/skills/*
# tc-prepush is repo-authored for this repo, not vendored, so it is tracked.
!.claude/skills/tc-prepush/

# Review reports — transient, regenerated per commit.
.review/
.lib-boundary-probe/
.react-hooks-refs-probe/
.nav-history-probe/

# Fastlane / iOS TestFlight pipeline (#262). The App Store Connect API key is
# decoded from a secret at build time and must never be committed; the rest is
# fastlane/gym output.
fastlane/AuthKey.p8
fastlane/dist_cert.p12
fastlane/dist_profile.mobileprovision
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
/build/
/vendor/
.bundle/
*.ipa
*.app.dSYM.zip
# Google Play upload lane (docs/native/play-store.md): the service-account key
# and the upload keystore are decoded from secrets at build time only.
fastlane/play-service-account.json
